{%- comment -%}
  Header, modelled on miduty.in:
    row 1 · logo · segmented range tabs (Wellness / Sports Nutrition / Ayurveda) · search, account, cart
    row 2 · centred menu. A link pointing at "#concerns" opens the concern mega panel.
  Phone: menu · logo · search · cart, with the range tabs as a full-width switch underneath.
{%- endcomment -%}
{%- assign menu = linklists[section.settings.menu] -%}
{%- assign here = request.path -%}
{%- capture tabs -%}
  {%- assign active_set = false -%}
  {%- for block in section.blocks -%}
    {%- if here == block.settings.link and block.settings.link != '/collections/all' -%}{%- assign active_set = true -%}{%- endif -%}
  {%- endfor -%}
  {%- for block in section.blocks -%}
    {%- assign on = false -%}
    {%- if here == block.settings.link -%}{%- assign on = true -%}{%- endif -%}
    {%- if active_set == false and forloop.first -%}{%- assign on = true -%}{%- endif -%}
    <a class="tabs__t{% if on %} is-on{% endif %}" href="{{ block.settings.link }}"{% if on %} aria-current="true"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
  {%- endfor -%}
{%- endcapture -%}
<header class="hdr" data-hdr>
  <div class="hdr__bar wrap">
    <button type="button" class="iconbtn hdr__burger" data-open="menu" aria-label="Open menu">{% render 'icon', name: 'menu', size: 24 %}</button>
    {% render 'logo', class: 'hdr__logo' %}
    {%- if section.blocks.size > 0 -%}<nav class="tabs hdr__tabs" aria-label="Ranges">{{ tabs }}</nav>{%- endif -%}
    <div class="hdr__actions">
      <button type="button" class="iconbtn" data-open="search" aria-label="Search">{% render 'icon', name: 'search', size: 24 %}</button>
      <a class="iconbtn hdr__acct" href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'user', size: 24 %}</a>
      <button type="button" class="iconbtn hdr__cart" data-open="cart" aria-label="Open cart">
        {% render 'icon', name: 'bag', size: 24 %}<span class="hdr__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <nav class="hdr__nav" aria-label="Main">
    <div class="hdr__navin wrap">
      {%- for link in menu.links -%}
        {%- if link.url == '#concerns' -%}
          <div class="hdr__item" data-drop>
            <button type="button" class="hdr__link" data-drop-btn aria-expanded="false">{{ link.title }} {% render 'icon', name: 'chev', size: 14 %}</button>
            <div class="mega" data-drop-panel hidden>
              <div class="mega__inner wrap">
                <div class="mega__grid">
                  {%- for c in metaobjects.concern.values -%}
                    <a class="mega__item redraw" href="{{ c.system.url }}" style="--pc:{{ c.colour.value }}">
                      <span class="mega__icon">{% render 'art', key: c.icon.value, class: 'ink' %}</span>
                      <span class="mega__text"><b>{{ c.title.value }}</b><span>{{ c.feel.value }}</span></span>
                    </a>
                  {%- endfor -%}
                </div>
                <div class="mega__side">
                  <a class="mega__tool" href="/pages/body-map">{% render 'icon', name: 'body', size: 22 %}<span><b>Body map</b>Tap where it bothers you</span></a>
                  <a class="mega__tool" href="/pages/find-your-brn">{% render 'icon', name: 'quiz', size: 22 %}<span><b>Find your BRN</b>Three questions, 60 seconds</span></a>
                  <a class="mega__tool" href="/pages/stacks">{% render 'icon', name: 'spark', size: 22 %}<span><b>Stacks</b>Ready-made combos that save up to 12%</span></a>
                </div>
              </div>
            </div>
          </div>
        {%- elsif link.links.size > 0 -%}
          <div class="hdr__item" data-drop>
            <button type="button" class="hdr__link" data-drop-btn aria-expanded="false">{{ link.title }} {% render 'icon', name: 'chev', size: 14 %}</button>
            <div class="drop" data-drop-panel hidden>
              {%- for sub in link.links -%}
                {%- assign sp = nil -%}
                {%- if sub.url contains '/products/' -%}{%- assign sh = sub.url | split: '/products/' | last -%}{%- assign sp = all_products[sh] -%}{%- endif -%}
                <a href="{{ sub.url }}"{% if sp %} class="drop__p" style="--pc:{{ sp.metafields.brn.colour.value }}"{% endif %}>{% if sp %}<i></i>{% endif %}{{ sub.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a class="hdr__link{% if link.url == here %} is-here{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </nav>

  {%- if section.blocks.size > 0 -%}<nav class="tabs hdr__mtabs wrap" aria-label="Ranges">{{ tabs }}</nav>{%- endif -%}
</header>

<aside class="mnav" data-panel="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="mnav__head">
    {% render 'logo', width: 78 %}
    <button type="button" class="iconbtn" data-close aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
  </div>
  <button type="button" class="hdr__msearch-btn" data-open="search">{% render 'icon', name: 'search', size: 18 %}<span>Search magnesium, liver, creatine…</span></button>
  <p class="eyebrow">Shop by concern</p>
  <div class="mnav__concerns">
    {%- for c in metaobjects.concern.values -%}
      <a href="{{ c.system.url }}" style="--pc:{{ c.colour.value }}"><span class="mnav__icon">{% render 'art', key: c.icon.value %}</span>{{ c.short.value }}</a>
    {%- endfor -%}
  </div>
  <div class="mnav__tools">
    <a href="/pages/body-map">{% render 'icon', name: 'body' %}Body map</a>
    <a href="/pages/find-your-brn">{% render 'icon', name: 'quiz' %}Find your BRN</a>
  </div>
  <nav class="mnav__links" aria-label="Menu">
    {%- for link in menu.links -%}
      {%- if link.url == '#concerns' -%}{%- continue -%}{%- endif -%}
      {%- if link.links.size > 0 -%}
        <details><summary>{{ link.title }} {% render 'icon', name: 'chev', size: 16 %}</summary>
          {%- for sub in link.links -%}<a href="{{ sub.url }}">{{ sub.title }}</a>{%- endfor -%}
        </details>
      {%- else -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
</aside>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu", "info": "A menu item linking to #concerns opens the Shop by concern panel." }
  ],
  "blocks": [
    { "type": "tab", "name": "Range tab", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Wellness" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Header", "blocks": [
    { "type": "tab", "settings": { "label": "Wellness", "link": "/collections/all" } },
    { "type": "tab", "settings": { "label": "Sports Nutrition", "link": "/collections/sports-nutrition" } },
    { "type": "tab", "settings": { "label": "Ayurveda", "link": "/collections/ayurveda" } }
  ] } ]
}
{% endschema %}

{%- comment -%}
  Framed banner slider, modelled on truebasics.com: the banner sits inside the
  page width with rounded corners and slides sideways, dots underneath.
  All copy lives in the uploaded artwork (separate desktop and phone files);
  a slide can be a muted video loop instead.
{%- endcomment -%}
<section class="hero" data-slider data-autoplay="{{ section.settings.autoplay }}" aria-roledescription="carousel" aria-label="Featured">
  <div class="hero__frame">
    <div class="hero__viewport">
      <div class="hero__track" data-slides>
        {%- for block in section.blocks -%}
          {%- assign s = block.settings -%}
          <div class="hero__slide{% if forloop.first %} is-on{% endif %}" data-slide aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ block.shopify_attributes }}>
            <a class="hero__link" href="{{ s.link | default: '/collections/all' }}" aria-label="{{ s.alt | default: 'See the offer' | escape }}" draggable="false">
              <div class="hero__desk">
                {%- if s.video != blank -%}
                  {% render 'video-slot', video: s.video, loop: true, ratio: '1500/650', colour: s.colour %}
                {%- else -%}
                  {% render 'media-slot', image: s.image_desktop, label: s.label, w: 1500, h: 650, art: s.art, colour: s.colour, eager: forloop.first, alt: s.alt %}
                {%- endif -%}
              </div>
              <div class="hero__mob">
                {% render 'media-slot', image: s.image_mobile, label: s.label, w: 1080, h: 1200, art: s.art, colour: s.colour, eager: forloop.first, alt: s.alt %}
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="hero__arrow hero__arrow--prev" data-prev aria-label="Previous banner">{% render 'icon', name: 'arrow-left' %}</button>
        <button type="button" class="hero__arrow hero__arrow--next" data-next aria-label="Next banner">{% render 'icon', name: 'arrow' %}</button>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="hero__dots" data-dots>
        {%- for block in section.blocks -%}<button type="button" class="hero__dot{% if forloop.first %} is-on{% endif %}" aria-label="Banner {{ forloop.index }}"></button>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Hero banners",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate", "default": true }
  ],
  "blocks": [
    { "type": "slide", "name": "Banner", "settings": [
      { "type": "image_picker", "id": "image_desktop", "label": "Desktop artwork", "info": "1500 × 650 px. Put all text in the artwork." },
      { "type": "image_picker", "id": "image_mobile", "label": "Phone artwork", "info": "1080 × 1200 px. A separate design, not a crop." },
      { "type": "video", "id": "video", "label": "Desktop video loop (optional)", "info": "Muted MP4, 6–10 s, under 8 MB." },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "alt", "label": "Describe the banner (for screen readers)" },
      { "type": "text", "id": "label", "label": "Placeholder label", "default": "Hero banner" },
      { "type": "color", "id": "colour", "label": "Placeholder colour", "default": "#5E8A33" },
      { "type": "text", "id": "art", "label": "Placeholder drawing key", "default": "m-root" }
    ] }
  ],
  "presets": [ { "name": "Hero banners", "blocks": [
    { "type": "slide", "settings": { "label": "Hero banner 1 · launch offer", "colour": "#5E8A33", "art": "m-root" } },
    { "type": "slide", "settings": { "label": "Hero banner 2 · Magnesium + Tulsi", "colour": "#6A5FA8", "art": "i-tulsi" } },
    { "type": "slide", "settings": { "label": "Hero banner 3 · Gym Stack", "colour": "#C0553A", "art": "i-creatine" } },
    { "type": "slide", "settings": { "label": "Hero banner 4 · Bone & Joint", "colour": "#5F84AA", "art": "c-joint" } }
  ] } ]
}
{% endschema %}

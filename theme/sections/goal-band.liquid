{%- comment -%} Shop by goal, modelled on getmymettle.com: a dark photo/video band with white line icons. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="goals" style="--g1:{{ s.colour_1 }};--g2:{{ s.colour_2 }}">
  <div class="goals__bg" aria-hidden="true">
    {%- if s.video != blank -%}
      {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', class: 'goals__media' }}
    {%- elsif s.image != blank -%}
      <img class="goals__media" src="{{ s.image | image_url: width: 1920 }}" alt="" loading="lazy">
    {%- endif -%}
  </div>
  <div class="wrap goals__in">
    <h2 class="ruled">{{ s.heading }}</h2>
    <div class="goals__grid">
      {%- for block in section.blocks -%}
        <a class="goal" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          <span class="goal__icon">{% render 'art', key: block.settings.icon %}</span>
          <span class="goal__t">{{ block.settings.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop by goal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Goal" },
    { "type": "image_picker", "id": "image", "label": "Background photo", "info": "1920 × 600 px, darkened automatically." },
    { "type": "video", "id": "video", "label": "Or a background video loop" },
    { "type": "color", "id": "colour_1", "label": "Tint (top)", "default": "#1E1024" },
    { "type": "color", "id": "colour_2", "label": "Tint (bottom)", "default": "#4A1F66" }
  ],
  "blocks": [ { "type": "goal", "name": "Goal", "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "icon", "label": "Icon key", "default": "c-strength" },
    { "type": "url", "id": "link", "label": "Link" }
  ] } ],
  "presets": [ { "name": "Shop by goal", "blocks": [
    { "type": "goal", "settings": { "title": "Muscle & Strength", "icon": "c-strength", "link": "/collections/strength-muscle" } },
    { "type": "goal", "settings": { "title": "Healthy Weight Gain", "icon": "s-underweight", "link": "/collections/strength-muscle" } },
    { "type": "goal", "settings": { "title": "Daily Energy", "icon": "c-immunity", "link": "/collections/daily-energy-immunity" } },
    { "type": "goal", "settings": { "title": "Liver & Detox", "icon": "c-liver", "link": "/collections/liver-care" } },
    { "type": "goal", "settings": { "title": "Joints & Bones", "icon": "c-joint", "link": "/collections/joint-comfort" } },
    { "type": "goal", "settings": { "title": "Sleep & Stress", "icon": "c-sleep", "link": "/collections/sleep-stress" } }
  ] } ]
}
{% endschema %}

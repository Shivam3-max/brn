<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#FFFFFF">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{% if page_title %}{{ page_title }} · BRN{% else %}BRN · Bare Root Nutrition{% endif %}</title>
  {%- if page_description %}<meta name="description" content="{{ page_description | strip_html | escape }}">{% endif %}
  <meta property="og:site_name" content="BRN · Bare Root Nutrition">
  <meta property="og:title" content="{{ page_title | default: 'BRN · Bare Root Nutrition' }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700;800&family=Figtree:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&family=IBM+Plex+Mono:wght@400;500&display=swap">

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  {{ 'sections.css' | asset_url | stylesheet_tag }}

  <style>
    :root { --ink: {{ settings.colour_ink | default: '#403322' }}; --moss: {{ settings.colour_accent | default: '#4F6F3A' }}; }
  </style>

  <script>
    /* Flags, set before first paint.
       - reveal-ready gates the scroll-reveal styles: nothing starts hidden unless
         this ran AND IntersectionObserver exists, so a JS failure can never strand
         content at opacity 0. A 4 s failsafe shows everything regardless.
       - ?still=1 renders the final state of every animation (review/screenshots).
       - ?webgl=off forces the drawn fallbacks. */
    (function () {
      var d = document.documentElement, q = location.search;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var still = /[?&]still=1/.test(q) || reduce;
      d.classList.remove('no-js'); d.classList.add('js');
      if (still) d.setAttribute('data-still', '');
      else if ('IntersectionObserver' in window) d.classList.add('reveal-ready');
      setTimeout(function () { d.classList.add('is-shown'); }, 4000);
      var conn = navigator.connection || {};
      var gl = {{ settings.enable_webgl | json }} && !still && !/[?&]webgl=off/.test(q) &&
        window.innerWidth >= 900 && !conn.saveData && (navigator.hardwareConcurrency || 4) >= 4;
      if (gl) { try { var c = document.createElement('canvas'); gl = !!(c.getContext('webgl2') || c.getContext('webgl')); } catch (e) { gl = false; } }
      window.BRN = {
        still: still, gl: gl,
        moneyFormat: {{ shop.money_format | json }},
        routes: { cart: {{ routes.cart_url | json }}, add: {{ routes.cart_add_url | json }}, change: {{ routes.cart_change_url | json }}, search: {{ routes.predictive_search_url | json }} },
        assets: { gl: {{ 'brn-gl.js' | asset_url | json }} },
        freeShip: {{ settings.free_ship_threshold | default: 0 | times: 100 }}
      };
    })();
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "BRN · Bare Root Nutrition",
    "url": {{ shop.url | json }},
    "parentOrganization": { "@type": "Organization", "name": "Nimai Lifesciences" }
  }
  </script>
  {%- if template.name == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "brand": { "@type": "Brand", "name": "BRN" },
    "description": {{ product.metafields.brn.tagline.value | json }},
    "offers": { "@type": "Offer", "priceCurrency": "INR", "price": {{ product.price | divided_by: 100 }}, "availability": "https://schema.org/InStock" }
  }
  </script>
  {%- endif -%}
</head>

<body class="t-{{ template.name }}{% if template.suffix %} t-{{ template.suffix }}{% endif %}">
  <a class="skip" href="#main">Skip to content</a>
  {% render 'svg-defs' %}

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}
  {% render 'search-overlay' %}
  {% render 'media-modal' %}
  {% render 'products-json' %}
  <nav class="mbar" aria-label="Quick links">
    <a class="mbar__i" href="/collections/all">{% render 'icon', name: 'grid' %}<span>Shop</span></a>
    <button type="button" class="mbar__i" data-open="cart">{% render 'icon', name: 'bag' %}<span>Cart</span><span class="mbar__n" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></button>
    <a class="mbar__i" href="{{ routes.account_url }}">{% render 'icon', name: 'user' %}<span>Account</span></a>
    <button type="button" class="mbar__i" data-open="search">{% render 'icon', name: 'search' %}<span>Search</span></button>
  </nav>
  <div class="scrim" data-scrim hidden></div>
  <div class="toast" data-toast role="status" aria-live="polite" hidden></div>

  {%- if settings.whatsapp != blank -%}
    <a class="wa-fab" href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener" aria-label="Chat with BRN on WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>
  {%- endif -%}

  <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
  <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" type="module"></script>
</body>
</html>

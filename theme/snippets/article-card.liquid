{%- assign c = article.metafields.brn.concern.value -%}
{%- assign p = article.metafields.brn.product.value -%}
{%- assign f = p.metafields.brn.formula.value | first -%}
<article class="acard rv" style="--pc:{{ c.colour.value | default: '#403322' }}">
  <a class="acard__media" href="{{ article.url }}" aria-hidden="true" tabindex="-1">
    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 700 }}" alt="" loading="lazy">
    {%- else -%}
      <span class="acard__art">{% render 'art', key: metaobjects.ingredient[f.i].art.value, class: 'ink' %}</span>
    {%- endif -%}
  </a>
  <div class="acard__body">
    <p class="acard__meta"><span>{{ c.short.value }}</span> · {{ article.metafields.brn.read_minutes.value }} min read</p>
    <h3 class="acard__t"><a href="{{ article.url }}">{{ article.title }}</a></h3>
    <p class="acard__x">{{ article.excerpt }}</p>
  </div>
</article>

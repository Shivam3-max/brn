{%- comment -%}
  Shared gradients for every pack-art bottle on the page. Defined once so each
  bottle can reference them without duplicate ids.
{%- endcomment -%}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="brn-cyl" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#E9E4DC"/>
      <stop offset=".18" stop-color="#FFFFFF"/>
      <stop offset=".42" stop-color="#FBFAF7"/>
      <stop offset=".78" stop-color="#EEE9E1"/>
      <stop offset="1" stop-color="#D9D2C6"/>
    </linearGradient>
    <linearGradient id="brn-gloss" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity=".18"/>
      <stop offset=".25" stop-color="#fff" stop-opacity=".28"/>
      <stop offset=".5" stop-color="#fff" stop-opacity="0"/>
      <stop offset="1" stop-color="#000" stop-opacity=".22"/>
    </linearGradient>
    <radialGradient id="brn-shadow" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#403322" stop-opacity=".22"/>
      <stop offset="1" stop-color="#403322" stop-opacity="0"/>
    </radialGradient>
  </defs>
</svg>

{%- comment -%} UI icons on a 24 grid. {% render 'icon', name: 'search' %} {%- endcomment -%}
<svg class="icon icon--{{ name }} {{ class }}" viewBox="0 0 24 24" width="{{ size | default: 20 }}" height="{{ size | default: 20 }}" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
{%- case name -%}
{%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/>
